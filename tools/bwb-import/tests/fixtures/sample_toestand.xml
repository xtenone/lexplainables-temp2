        <li.nr>h.</li.nr>
        <al>Onze Minister: Onze Minister van Financiën; </al>
      <meta-data><jcis><jci versie="1.3" verwijzing="jci1.3:c:BWBR0004770&amp;hoofdstuk=I&amp;artikel=2&amp;lid=1&amp;o=h&amp;z=2026-01-01&amp;g=2026-01-01" onderdeel="o=h"/></jcis></meta-data></li>
